# Upload a populated copy to a private S3 bucket and reference it from the
# ECS container definition's environmentFiles property.
GRPC_ADDRESS=0.0.0.0:50051
MINIO_ENDPOINT=minio.internal.example:9000
MINIO_SECURE=true
MINIO_SOURCE_BUCKET=features
MINIO_TILES_BUCKET=tiles
GDAL2TILES_COMMAND=gdal2tiles.py
TILE_ZOOM=10-19
