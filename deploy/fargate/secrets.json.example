[
  {
    "name": "RABBITMQ_URL",
    "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:zpi/rabbitmq-url"
  },
  {
    "name": "DATABASE_URL",
    "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:zpi/database-url"
  },
  {
    "name": "MINIO_ACCESS_KEY",
    "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:zpi/minio-access-key"
  },
  {
    "name": "MINIO_SECRET_KEY",
    "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:zpi/minio-secret-key"
  }
]
