# Runtime configuration shared by local .env files and ECS task definitions.
# In Fargate, inject RABBITMQ_URL, DATABASE_URL, MINIO_ACCESS_KEY, and
# MINIO_SECRET_KEY through the task definition's Secrets Manager references.

# Downloader API
GRPC_ADDRESS=0.0.0.0:50051

# RabbitMQ
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app
RABBITMQ_URL=amqp://app:app@localhost:5672/
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:app@localhost:5432/app

# MinIO / S3-compatible storage
MINIO_ROOT_USER=app
MINIO_ROOT_PASSWORD=app12345
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=app
MINIO_SECRET_KEY=app12345
MINIO_SECURE=false
MINIO_SOURCE_BUCKET=features
MINIO_TILES_BUCKET=tiles
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Processor
GDAL2TILES_COMMAND=gdal2tiles.py
# Optional range such as 10-19. Empty lets GDAL choose the zoom range.
TILE_ZOOM=
